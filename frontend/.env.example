# FrameShift API (local FastAPI or deployed Modal endpoint)
NEXT_PUBLIC_API_URL=http://localhost:8000

# Auth0 Next.js SDK v4 — create a Regular Web Application
AUTH0_DOMAIN=your-tenant.eu.auth0.com
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=
AUTH0_SECRET=
APP_BASE_URL=http://localhost:3000

# Identifier of the Auth0 API used by the FastAPI backend
AUTH0_AUDIENCE=https://api.frameshift.app

# Supabase Postgres metadata database (service key stays server-only)
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SECRET_KEY=
