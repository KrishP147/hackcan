# Copy to .env.modal, fill the values, then create the Modal secret with:
# modal secret create frameshift-secrets --from-dotenv .env.modal

GEMINI_API_KEY=
FRONTEND_ORIGIN=https://your-frontend.vercel.app

# Optional. Leave blank if the frontend is not sending Auth0 access tokens.
AUTH0_DOMAIN=
AUTH0_AUDIENCE=

# Durable media storage and signed cache hydration.
SUPABASE_URL=
SUPABASE_SECRET_KEY=
SUPABASE_MEDIA_BUCKET=project-media
FRAMESHIFT_IMPORT_SECRET=
