# FrameShift backend configuration

# Gemini API (generative replace / background replace)
GEMINI_API_KEY=

# Optional: enable the simple per-IP rate limiter (off for status polling)
RATE_LIMIT=0

# CORS origin for a deployed frontend (exact scheme + host, no trailing slash)
FRONTEND_ORIGIN=http://localhost:3000

# Optional Auth0 JWT validation (only required if the frontend sends tokens)
AUTH0_DOMAIN=
AUTH0_AUDIENCE=

# Keep RAFT deferred until after confirmed SAM2 tracking. This avoids MPS/CUDA
# contention and is the production setting.
FRAMESHIFT_PRECOMPUTE_FLOWS=0

# Adjacent frame pairs per RAFT call. Keep at 1 on MPS/CPU; Modal selects 2 on
# L4/A10 and 4 on L40S/H100 unless explicitly overridden at deploy time.
FRAMESHIFT_RAFT_BATCH_SIZE=1

# Optional: Backend B / CUDA kernel flags (Doc 2 — dev only, keep off in deploy)
FRAMESHIFT_USE_SYNTH=0
FRAMESHIFT_USE_CUDA_KERNEL=0
