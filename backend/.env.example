# FrameShift backend configuration

# Gemini API (generative replace / background replace)
GEMINI_API_KEY=

# Cloudinary (video upload/delivery)
CLOUDINARY_URL=

# Optional: enable per-IP rate limiting (on by default in Modal deploy)
RATE_LIMIT=0

# Optional: Backend B / CUDA kernel flags (Doc 2 — dev only, keep off in deploy)
FRAMESHIFT_USE_SYNTH=0
FRAMESHIFT_USE_CUDA_KERNEL=0
